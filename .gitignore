# package.json and package-lock.json ARE checked in: scripts/check-workflows.mjs
# needs an exactly-pinned, integrity-locked parser rather than whatever
# `npm install js-yaml@5` resolves to on the day it runs.
node_modules/

# Claude Code worktrees, scratch and runtime state. A worktree under .claude/
# otherwise shows up as untracked in the main checkout, where `git add -A`
# would take it. The shared settings stay tracked.
.claude/*
!.claude/settings.json
!.claude/launch.json
!.claude/hooks/
